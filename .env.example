# Local dev fills these; a cloud deploy injects them as container env vars.
SUPERO_URL=https://api.supero.dev
SUPERO_DOMAIN=stephen-rhodes
SUPERO_PROJECT=reclaim
SUPERO_ADMIN_EMAIL=admin@reclaim.dev
SUPERO_API_KEY=ak_...

# Multi-tenant from the first run, not retrofitted.
SUPERO_IS_MULTI_TENANT=true
SUPERO_TENANT_NOUN_SINGULAR=organisation
SUPERO_TENANT_NOUN_PLURAL=organisations

# LOCAL only — a cloud host injects its own PORT.
PORT=5648
